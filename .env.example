# Ollama (local). qwen2.5:3b is pulled and returns tool calls on this Mac.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=16384

# Robinhood Trading MCP (official agentic endpoint)
RH_MCP_URL=https://agent.robinhood.com/mcp/trading

# Safety: 1 refuses place_/cancel_/other writes before they leave the machine.
# review_* still runs (it simulates, it does not send an order).
DRY_RUN=1

# Agent loop
MAX_TOOL_ROUNDS=120
OLLAMA_TEMPERATURE=0.2

# OAuth callback
RH_OAUTH_PORT=8765
