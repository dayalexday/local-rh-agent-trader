# Ollama (local). qwen2.5:3b is pulled and returns tool calls on this Mac.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=180

# Robinhood Trading MCP (official agentic endpoint)
RH_MCP_URL=https://agent.robinhood.com/mcp/trading

# Safety: 1 refuses place_/cancel_/other writes before they leave the machine.
# review_* still runs (it simulates, it does not send an order).
DRY_RUN=1

# Agent loop (the Monday tool-calling path, not the research memos)
MAX_TOOL_ROUNDS=120
OLLAMA_TEMPERATURE=0.2

# Research team. ollama | openai | mock
# Per-agent override: MOMENTUM_PROVIDER, SENTIMENT_PROVIDER, RISK_PROVIDER,
# PORTFOLIO_PROVIDER, REFLECTION_PROVIDER and the matching *_MODEL.
MODEL_PROVIDER=ollama
# Memo calls use a smaller context than the broker tool loop. Fits an 8GB Mac.
TEAM_NUM_CTX=4096

# OpenAI-compatible chat endpoint (OpenAI, LM Studio, llama.cpp, vLLM, …).
# Used when MODEL_PROVIDER=openai or a single role is set to openai.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_S=60

# Risk limits for the team. The model cannot raise these.
MAX_NAME_WEIGHT=0.10
MAX_SECTOR_WEIGHT=0.40
MAX_LEVERAGED_WEIGHT=0.50
SENTIMENT_VETO=-0.5
# Paper buying power for illustrative dollars when the broker is not contacted.
PAPER_BUYING_POWER=10000

# OAuth callback
RH_OAUTH_PORT=8765
